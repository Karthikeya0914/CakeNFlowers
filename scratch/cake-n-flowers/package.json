{
  "name": "cake-n-flowers-monorepo",
  "version": "1.0.0",
  "description": "Cake N Flowers - Luxury Pastry & Bespoke Floral Delivery Platform",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^1.0.0-beta.22"
  }
}
