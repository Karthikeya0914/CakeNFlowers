{"step_index":56,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-06T07:59:34Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const prisma = require('../utils/prisma');\n\nasync function getReviewsByProduct(req, res, next) {\n  try {\n    const { productId } = req.params;\n\n    const reviews = await prisma.review.findMany({\n      where: { productId },\n      orderBy: { createdAt: 'desc' }\n    });\n\n    res.json({ reviews });\n  } catch (err) {\n    next(err);\n  }\n}\n\nasync function createReview(req, res, next) {\n  try {\n    const { productId, rating, comment, userName } = req.body;\n\n    if (!productId || !rating || !comment) {\n      return res.status(400).json({ error: 'Product ID, rating, and review comment are required.' });\n    }\n\n    const name = req.user ? req.user.name : userName || 'Verified Guest';\n    const userId = req.user ? req.user.id : null;\n\n    const review = await prisma.review.create({\n      data: {\n        productId,\n        userId,\n        userName: name,\n        rating: Math.min(5, Math.max(1, parseInt(rating))),\n        comment: comment.trim()\n      }\n    });\n\n    // Recalculate product rating average\n    const allReviews = await prisma.review.findMany({\n      where: { productId },\n      select: { rating: true }\n    });\n\n    const totalStars = allReviews.reduce((sum, r) => sum + r.rating, 0);\n    const ratingAvg = Math.round((totalStars / allReviews.length) * 10) / 10;\n\n    await prisma.product.update({\n      where: { id: productId },\n      data: {\n        ratingAvg,\n        reviewsCount: allReviews.length\n      }\n    });\n\n    res.status(201).json({ review, ratingAvg, reviewsCount: allReviews.length });\n  } catch (err) {\n    next(err);\n  }\n}\n\nmodule.exports = {\n  getReviewsByProduct,\n  createReview\n};\n","Description":"Create reviewController for customer product feedback","Overwrite":true,"TargetFile":"C:\\Users\\karth\\.gemini\\antigravity\\scratch\\cake-n-flowers\\backend\\src\\controllers\\reviewController.js","toolAction":"Writing review controller","toolSummary":"Review controller"}}]}
