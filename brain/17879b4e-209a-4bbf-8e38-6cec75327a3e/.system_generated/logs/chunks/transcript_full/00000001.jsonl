{"step_index":58,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-06T07:59:39Z","thinking":"**Defining Admin Controller Functionality**\n\nThe focus is defining the admin controller. Requires implementation of several functionalities. These include retrieving dashboard statistics (revenue, order counts, stock levels, recent orders and category sales breakdowns).\n\nAlso needs to implement order management (searchable orders, filtering by status, pagination) and status updates. The desired status updates involve changing the order status.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const prisma = require('../utils/prisma');\n\n// GET /api/admin/dashboard\nasync function getDashboardStats(req, res, next) {\n  try {\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n\n    const [\n      totalOrders,\n      orders,\n      recentOrders,\n      lowStockProducts,\n      categoriesCount,\n      customersCount\n    ] = await Promise.all([\n      prisma.order.count(),\n      prisma.order.findMany({ select: { total: true, status: true, createdAt: true } }),\n      prisma.order.findMany({\n        take: 6,\n        orderBy: { createdAt: 'desc' },\n        include: {\n          items: {\n            include: { product: { select: { name: true } } }\n          }\n        }\n      }),\n      prisma.product.findMany({\n        where: { stock: { lte: 15 } },\n        select: { id: true, name: true, stock: true, basePrice: true }\n      }),\n      prisma.category.count(),\n      prisma.user.count({ where: { role: 'CUSTOMER' } })\n    ]);\n\n    const totalRevenue = orders\n      .filter((o) => o.status !== 'CANCELLED')\n      .reduce((sum, o) => sum + o.total, 0);\n\n    const todayOrders = orders.filter((o) => new Date(o.createdAt) >= today).length;\n    const activeDeliveries = orders.filter((o) =>\n      ['CONFIRMED', 'PREPARING', 'QUALITY_PASSED', 'OUT_FOR_DELIVERY'].includes(o.status)\n    ).length;\n\n    res.json({\n      stats: {\n        totalRevenue: Math.round(totalRevenue * 100) / 100,\n        totalOrders,\n        todayOrders,\n        activeDeliveries,\n        lowStockCount: lowStockProducts.length,\n        categoriesCount,\n        customersCount\n      },\n      recentOrders,\n      lowStockProducts\n    });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// GET /api/admin/orders\nasync function getAllOrders(req, res, next) {\n  try {\n    const { status, search } = req.query;\n\n    const where = {};\n    if (status && status !== 'ALL') {\n      where.status = status;\n    }\n\n    if (search) {\n      const q = search.trim();\n      where.OR = [\n        { orderNumber: { contains: q } },\n        { recipientName: { contains: q } },\n        { guestEmail: { contains: q } }\n      ];\n    }\n\n    const orders = await prisma.order.findMany({\n      where,\n      include: {\n        items: {\n          include: { product: true }\n        }\n      },\n      orderBy: { createdAt: 'desc' }\n    });\n\n    res.json({ orders });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// PUT /api/admin/orders/:id/status\nasync function updateOrderStatus(req, res, next) {\n  try {\n    const { id } = req.params;\n    const { status, courierName, trackingNumber, notes, paymentStatus } = req.body;\n\n    const data = {};\n    if (status) data.status = status;\n    if (courierName !== undefined) data.courierName = courierName;\n    if (trackingNumber !== undefined) data.trackingNumber = trackingNumber;\n    if (notes !== undefined) data.notes = notes;\n    if (paymentStatus) data.paymentStatus = paymentStatus;\n\n    const updated = await prisma.order.update({\n      where: { id },\n      data,\n      include: { items: true }\n    });\n\n    res.json({ message: 'Order status updated successfully.', order: updated });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// POST /api/admin/products\nasync function createProduct(req, res, next) {\n  try {\n    const {\n      name,\n      slug,\n      description,\n      basePrice,\n      categoryId,\n      images,\n      isCustomizable,\n      hasPhotoUpload,\n      isEggless,\n      stock,\n      occasionTags,\n      variants\n    } = req.body;\n\n    if (!name || !description || !basePrice || !categoryId) {\n      return res.status(400).json({ error: 'Name, description, basePrice, and categoryId are required.' });\n    }\n\n    const finalSlug = slug || name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\n\n    const product = await prisma.product.create({\n      data: {\n        name,\n        slug: finalSlug,\n        description,\n        basePrice: parseFloat(basePrice),\n        categoryId,\n        images: typeof images === 'string' ? images : JSON.stringify(images || []),\n        isCustomizable: Boolean(isCustomizable),\n        hasPhotoUpload: Boolean(hasPhotoUpload),\n        isEggless: Boolean(isEggless),\n        stock: parseInt(stock) || 50,\n        occasionTags: occasionTags || '',\n        variants: variants && variants.length ? {\n          create: variants.map((v) => ({\n            name: v.name,\n            priceModifier: parseFloat(v.priceModifier) || 0.0,\n            isDefault: Boolean(v.isDefault)\n          }))\n        } : undefined\n      },\n      include: { variants: true, category: true }\n    });\n\n    res.status(201).json({ message: 'Product created successfully.', product });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// PUT /api/admin/products/:id\nasync function updateProduct(req, res, next) {\n  try {\n    const { id } = req.params;\n    const {\n      name,\n      description,\n      basePrice,\n      categoryId,\n      images,\n      isCustomizable,\n      hasPhotoUpload,\n      isEggless,\n      stock,\n      active,\n      occasionTags\n    } = req.body;\n\n    const data = {};\n    if (name) data.name = name;\n    if (description) data.description = description;\n    if (basePrice !== undefined) data.basePrice = parseFloat(basePrice);\n    if (categoryId) data.categoryId = categoryId;\n    if (images !== undefined) {\n      data.images = typeof images === 'string' ? images : JSON.stringify(images);\n    }\n    if (isCustomizable !== undefined) data.isCustomizable = Boolean(isCustomizable);\n    if (hasPhotoUpload !== undefined) data.hasPhotoUpload = Boolean(hasPhotoUpload);\n    if (isEggless !== undefined) data.isEggless = Boolean(isEggless);\n    if (stock !== undefined) data.stock = parseInt(stock);\n    if (active !== undefined) data.active = Boolean(active);\n    if (occasionTags !== undefined) data.occasionTags = occasionTags;\n\n    const updated = await prisma.product.update({\n      where: { id },\n      data,\n      include: { variants: true, category: true }\n    });\n\n    res.json({ message: 'Product updated successfully.', product: updated });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// DELETE /api/admin/products/:id\nasync function deleteProduct(req, res, next) {\n  try {\n    const { id } = req.params;\n    await prisma.product.delete({\n      where: { id }\n    });\n    res.json({ message: 'Product deleted.' });\n  } catch (err) {\n    next(err);\n  }\n}\n\n// POST /api/admin/coupons\nasync function createCoupon(req, res, next) {\n  try {\n    const { code, discountType, discountValue, minOrderAmount, validTo } = req.body;\n\n    if (!code || !discountType || discountValue === undefined) {\n      return res.status(400).json({ error: 'Code, discountType, and discountValue are required.' });\n    }\n\n    const coupon = await prisma.coupon.create({\n      data: {\n        code: code.toUpperCase().trim(),\n        discountType,\n        discountValue: parseFloat(discountValue),\n        minOrderAmount: parseFloat(minOrderAmount) || 0.0,\n        validTo: validTo ? new Date(validTo) : null\n      }\n    });\n\n    res.status(201).json({ coupon });\n  } catch (err) {\n    next(err);\n  }\n}\n\nmodule.exports = {\n  getDashboardStats,\n  getAllOrders,\n  updateOrderStatus,\n  createProduct,\n  updateProduct,\n  deleteProduct,\n  createCoupon\n};\n","Description":"Create adminController for management portal and analytics","Overwrite":true,"TargetFile":"C:\\Users\\karth\\.gemini\\antigravity\\scratch\\cake-n-flowers\\backend\\src\\controllers\\adminController.js","toolAction":"Writing admin controller","toolSummary":"Admin controller"}}]}
