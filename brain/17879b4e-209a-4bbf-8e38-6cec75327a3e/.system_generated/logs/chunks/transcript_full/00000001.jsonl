{"step_index":98,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-06T08:05:19Z","thinking":"**Designing Cart Context Component**\n\nCreating `CartContext.jsx` to manage the shopping cart state. This component will store cart items fetched from `localStorage`. The cart item structure defined includes properties for item identification, product details, and customizations. An `addToCart` function will handle adding and updating items, incrementing quantity for existing items with matching attributes and appending unique items.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { createContext, useContext, useState, useEffect } from 'react';\nimport { api } from '../api/client';\n\nconst CartContext = createContext();\n\nexport function CartProvider({ children }) {\n  const [items, setItems] = useState(() => {\n    try {\n      const saved = localStorage.getItem('cnf_cart');\n      return saved ? JSON.parse(saved) : [];\n    } catch (e) {\n      return [];\n    }\n  });\n\n  const [isCartOpen, setIsCartOpen] = useState(false);\n  const [coupon, setCoupon] = useState(() => {\n    try {\n      const saved = localStorage.getItem('cnf_coupon');\n      return saved ? JSON.parse(saved) : null;\n    } catch (e) {\n      return null;\n    }\n  });\n\n  const [deliverySlot, setDeliverySlot] = useState('Standard (1:00 PM - 6:00 PM)');\n  const [deliveryDate, setDeliveryDate] = useState(() => {\n    const d = new Date();\n    d.setDate(d.getDate() + 1); // Tomorrow by default\n    return d.toISOString().split('T')[0];\n  });\n\n  useEffect(() => {\n    localStorage.setItem('cnf_cart', JSON.stringify(items));\n  }, [items]);\n\n  useEffect(() => {\n    if (coupon) {\n      localStorage.setItem('cnf_coupon', JSON.stringify(coupon));\n    } else {\n      localStorage.removeItem('cnf_coupon');\n    }\n  }, [coupon]);\n\n  const addToCart = (productData) => {\n    const cartId = `${productData.productId}_${productData.variantId || 'base'}_${Date.now()}`;\n    const newItem = {\n      cartId,\n      productId: productData.productId,\n      name: productData.name,\n      price: productData.price,\n      image: productData.image,\n      variantId: productData.variantId || null,\n      variantName: productData.variantName || null,\n      quantity: productData.quantity || 1,\n      customFlavor: productData.customFlavor || null,\n      customInscription: productData.customInscription || null,\n      customMessageCard: productData.customMessageCard || null,\n      customPhotoUrl: productData.customPhotoUrl || null,\n      isEggless: Boolean(productData.isEggless)\n    };\n\n    setItems((prev) => [...prev, newItem]);\n    setIsCartOpen(true);\n  };\n\n  const removeFromCart = (cartId) => {\n    setItems((prev) => prev.filter((item) => item.cartId !== cartId));\n  };\n\n  const updateQuantity = (cartId, quantity) => {\n    if (quantity <= 0) {\n      removeFromCart(cartId);\n      return;\n    }\n    setItems((prev) =>\n      prev.map((item) => (item.cartId === cartId ? { ...item, quantity } : item))\n    );\n  };\n\n  const clearCart = () => {\n    setItems([]);\n    setCoupon(null);\n    localStorage.removeItem('cnf_cart');\n    localStorage.removeItem('cnf_coupon');\n  };\n\n  const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);\n\n  const calculateDeliveryFee = (slot, amount) => {\n    if (!slot) return 5.0;\n    const lower = slot.toLowerCase();\n    if (lower.includes('midnight')) return 12.0;\n    if (lower.includes('express')) return 8.0;\n    if (amount >= 70.0) return 0.0;\n    return 5.0;\n  };\n\n  const deliveryFee = items.length > 0 ? calculateDeliveryFee(deliverySlot, subtotal) : 0;\n\n  const applyCoupon = async (code) => {\n    const res = await api.post('/coupons/validate', { code, subtotal });\n    if (res.valid) {\n      setCoupon({\n        code: res.code,\n        discount: res.discount,\n        discountType: res.discountType,\n        discountValue: res.discountValue\n      });\n      return res;\n    }\n  };\n\n  const removeCoupon = () => {\n    setCoupon(null);\n  };\n\n  // Compute live discount\n  let discountAmount = 0;\n  if (coupon) {\n    if (coupon.discountType === 'PERCENTAGE') {\n      discountAmount = Math.round(((subtotal * coupon.discountValue) / 100) * 100) / 100;\n    } else {\n      discountAmount = Math.min(coupon.discountValue, subtotal);\n    }\n  }\n\n  const total = Math.max(0, Math.round((subtotal + deliveryFee - discountAmount) * 100) / 100);\n  const itemCount = items.reduce((sum, item) => sum + item.quantity, 0);\n\n  const value = {\n    items,\n    addToCart,\n    removeFromCart,\n    updateQuantity,\n    clearCart,\n    isCartOpen,\n    setIsCartOpen,\n    coupon,\n    applyCoupon,\n    removeCoupon,\n    discountAmount,\n    deliveryDate,\n    setDeliveryDate,\n    deliverySlot,\n    setDeliverySlot,\n    deliveryFee,\n    subtotal: Math.round(subtotal * 100) / 100,\n    total,\n    itemCount\n  };\n\n  return <CartContext.Provider value={value}>{children}</CartContext.Provider>;\n}\n\nexport function useCart() {\n  const context = useContext(CartContext);\n  if (!context) throw new Error('useCart must be used within a CartProvider');\n  return context;\n}\n","Description":"Create CartContext for cart state, custom item configurations, and discounts","Overwrite":true,"TargetFile":"C:\\Users\\karth\\.gemini\\antigravity\\scratch\\cake-n-flowers\\frontend\\src\\context\\CartContext.jsx","toolAction":"Writing CartContext","toolSummary":"Cart context"}}]}
