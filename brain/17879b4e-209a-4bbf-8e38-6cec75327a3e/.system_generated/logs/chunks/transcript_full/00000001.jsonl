{"step_index":52,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-06T07:59:11Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const prisma = require('../utils/prisma');\n\nasync function validateCoupon(req, res, next) {\n  try {\n    const { code, subtotal } = req.body;\n\n    if (!code) {\n      return res.status(400).json({ error: 'Please enter a coupon code.' });\n    }\n\n    const coupon = await prisma.coupon.findUnique({\n      where: { code: code.toUpperCase().trim() }\n    });\n\n    if (!coupon || !coupon.active) {\n      return res.status(404).json({ error: 'Invalid or inactive promotional code.' });\n    }\n\n    const now = new Date();\n    if (coupon.validFrom && new Date(coupon.validFrom) > now) {\n      return res.status(400).json({ error: 'This coupon is not yet active.' });\n    }\n\n    if (coupon.validTo && new Date(coupon.validTo) < now) {\n      return res.status(400).json({ error: 'This coupon code has expired.' });\n    }\n\n    const orderAmount = parseFloat(subtotal) || 0;\n    if (orderAmount < coupon.minOrderAmount) {\n      return res.status(400).json({\n        error: `Minimum order amount of $${coupon.minOrderAmount.toFixed(2)} required for this code.`\n      });\n    }\n\n    let discount = 0;\n    if (coupon.discountType === 'PERCENTAGE') {\n      discount = (orderAmount * coupon.discountValue) / 100;\n    } else {\n      discount = Math.min(coupon.discountValue, orderAmount);\n    }\n\n    // Round to 2 decimals\n    discount = Math.round(discount * 100) / 100;\n\n    res.json({\n      valid: true,\n      code: coupon.code,\n      discountType: coupon.discountType,\n      discountValue: coupon.discountValue,\n      discount\n    });\n  } catch (err) {\n    next(err);\n  }\n}\n\nmodule.exports = {\n  validateCoupon\n};\n","Description":"Create couponController for coupon validation","Overwrite":true,"TargetFile":"C:\\Users\\karth\\.gemini\\antigravity\\scratch\\cake-n-flowers\\backend\\src\\controllers\\couponController.js","toolAction":"Writing coupon controller","toolSummary":"Coupon controller"}}]}
